# تنظیمات فرانت (در زمان build در کد جاسازی می‌شوند).
#
# آدرس API بک‌اند. برای توسعه‌ی محلی لازم نیست تنظیم شود (پیش‌فرض: http://localhost:8100/api/v1).
# در تولید الزامی است و فرانت و API باید هم‌سایت باشند (مثلاً app. و api. زیر یک دامنه).
NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1

# فقط برای نسخه‌ی نمایشی GitHub Pages: true (همراه NEXT_OUTPUT=export).
# build سروری با مقدار true عمداً شکست می‌خورد تا داده‌ی نمونه هرگز به تولید نرسد.
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_OUTPUT=export
# NEXT_PUBLIC_BASE_PATH=/partmachine
