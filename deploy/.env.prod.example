# تنظیمات راه‌اندازی تولید — به deploy/.env.prod کپی و پر کنید. فایل واقعی هرگز commit نمی‌شود.
# برنامه با تنظیمات ناامن (رمز کوتاه، دامنه‌ی نامشخص و…) اصلاً بالا نمی‌آید.

# دامنه‌ی سایت؛ API زیر همین دامنه در /api است. DNS این دامنه باید به IP سرور اشاره کند.
APP_DOMAIN=app.partmachine.ir

# رمزها: مقدار تصادفی بلند و فقط حروف و عدد (در آدرس اتصال بدون escape کار کند)، مثلاً:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ---- فایل‌ها (نقشه، مدرک، تصویر) ----
# local: روی دیسک همین سرور (volume «storage»؛ همراه پایگاه داده پشتیبان بگیرید)
# s3: فضای ابری S3-سازگار، مثلاً لیارا یا ابر آروان (سرویس پولی؛ فقط با تأیید مالک)
STORAGE_BACKEND=local
# فقط برای s3. مقدارها را از پنل سرویس بردارید؛ bucket را «خصوصی» بسازید. آدرس باید https باشد.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
# اگر رمز علامت $ دارد، آن را داخل '...' بگذارید
S3_SECRET_ACCESS_KEY=
# path برای بیشتر سرویس‌ها درست است؛ اگر سرویس virtual-hosted خواست، virtual بگذارید
S3_ADDRESSING_STYLE=path
# اختیاری: پوشه‌ای داخل bucket، اگر چند محیط (مثلاً staging) یک bucket دارند
S3_PREFIX=

# تعداد پروسه‌های API (معمولاً تعداد هسته‌های CPU)
WEB_CONCURRENCY=2

# برچسب ایمیج‌ها (مثلاً شماره‌ی نسخه یا commit) برای بازگشت به نسخه‌ی قبل
IMAGE_TAG=local

# پورت‌های سرور؛ در تولید ۸۰ و ۴۴۳ بمانند
HTTP_PORT=80
HTTPS_PORT=443
# فقط برای آزمون محلی روی پورت دیگر (مثلاً :8443)؛ در تولید خالی بماند
PUBLIC_PORT_SUFFIX=
