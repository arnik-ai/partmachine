# پروکسی معکوس با HTTPS خودکار (Let's Encrypt برای دامنه‌ی واقعی، گواهی محلی برای localhost).
# سایت و API زیر یک دامنه: /api/* به بک‌اند، بقیه به سایت.

{
	# اتصال‌هایی که سرآیند را خیلی کند می‌فرستند (حمله‌ی slowloris) بسته می‌شوند؛ بدنه برای
	# بارگذاری فایل ۵۰ مگابایتی روی اینترنت کند فرصت کافی دارد
	servers {
		timeouts {
			read_header 10s
			read_body 10m
			idle 2m
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		# سقف بک‌اند برای بارگذاری فایل ۵۰ مگابایت است؛ این‌جا کمی بیشتر تا خطای فارسی خود API برسد
		request_body {
			max_size 60MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	# HSTS فقط برای دامنه‌ی واقعی (روی localhost سایت‌های توسعه‌ی دیگر را خراب می‌کند)
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	log {
		output stdout
		format json
	}
}
