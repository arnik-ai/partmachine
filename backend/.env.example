# نمونه‌ی تنظیمات بک‌اند. برای توسعه‌ی محلی هیچ‌کدام لازم نیست (پیش‌فرض‌ها با docker-compose
# ریشه‌ی مخزن کار می‌کنند). در staging/production همه‌ی موارد «الزامی» باید تنظیم شوند؛
# در غیر این صورت برنامه با پیام خطای روشن شروع نمی‌شود.

# development | test | staging | production
ENVIRONMENT=development

# الزامی در تولید — فقط PostgreSQL پشتیبانی می‌شود
DATABASE_URL=postgresql+asyncpg://partmachine:partmachine@localhost:5433/partmachine
# الزامی در تولید
REDIS_URL=redis://localhost:6380/0

# الزامی در تولید: مقدار تصادفی حداقل ۳۲ بایت، مثلاً خروجی:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# originهای مجاز فرانت (جداشده با کاما) — در تولید فقط https
CORS_ORIGINS=http://localhost:3100
# نام دامنه‌های مجاز API — در تولید صریح، مثلاً api.partmachine.ir
ALLOWED_HOSTS=*

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# اختیاری (پیش‌فرض بر اساس محیط):
# COOKIE_SECURE=true
# DOCS_ENABLED=false
# RATE_LIMIT_FAIL_OPEN=false
# LOG_JSON=true
# MAX_BODY_BYTES=1000000
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=15000
