# برای توسعه‌ی محلی پیش‌فرض SQLite است؛ در تولید رشته‌ی Postgres بگذارید:
# DATABASE_URL=postgresql+asyncpg://partmachine:partmachine@localhost:5432/partmachine
DATABASE_URL=sqlite+aiosqlite:///./partmachine.db

# کلید امضای JWT — حتماً در تولید عوض شود
SECRET_KEY=change-me-in-production-a-very-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# مبدأهای مجاز فرانت (CORS)
CORS_ORIGINS=http://localhost:3000,https://arnik-ai.github.io
